<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RobotManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RobotManager.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="RobotManager">

    <TabBar>
        <Tab Title="Home">
            <Tab.Icon>
                <FontImageSource Glyph="&#xe3af;" FontFamily="FASolid" Size="24"/>
            </Tab.Icon>
            <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage"/>
        </Tab>
        <Tab Title="Robots">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf544;" FontFamily="FASolid" Size="24"/>
            </Tab.Icon>
            <ShellContent Title="Robots" ContentTemplate="{DataTemplate local:RobotsPage}" Route="RobotsPage"/>
        </Tab>
        <Tab Title="User">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf007;" FontFamily="FASolid" Size="24"/>
            </Tab.Icon>
            <ShellContent Title="Sign In" ContentTemplate="{DataTemplate local:UserPage}" Route="SignInPage"/>
        </Tab>
        <Tab Title="Settings">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf013;" FontFamily="FASolid" Size="24"/>
            </Tab.Icon>
            <ShellContent Title="Settings" ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage"/>
        </Tab>

    </TabBar>


</Shell>
