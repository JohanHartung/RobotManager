<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.ClinicVisitDetailPage"
             Title="ClinicVisitDetailPage">
    <Grid Padding="20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout Grid.Row="0">
            <HorizontalStackLayout Margin="0,0,0,0">
                <Label x:Name="NaoName" Text="{Binding Name, StringFormat='NAO {0}'}" Margin="0,0,10,0" FontSize="22" Grid.Column="0" VerticalTextAlignment="Center"/>
                <Label Text="{Binding Status, StringFormat='{0}'}" Opacity=".7" VerticalOptions="Center" FontSize="20">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsBack}" Value="True">
                            <Setter Property="Text" Value="Returned"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsBack}" Value="False">
                            <Setter Property="Text" Value="In Clinic"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>
            <Label x:Name="NaoHead" FontSize="15" Opacity=".6" Grid.Column="0" VerticalTextAlignment="Center"/>
            <Label x:Name="NaoBody" FontSize="15" Opacity=".6" Grid.Column="1" VerticalTextAlignment="Center"/>
            <Label Text="Issues:" FontSize="18" Margin="0,15"/>
            <CollectionView x:Name="IssueCV" EmptyView="No issues" Margin="0,5" MaximumHeightRequest="200" VerticalScrollBarVisibility="Always">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#303030" Margin="0,5" BorderColor="#303030" Padding="10" >
                            <VerticalStackLayout>
                                <Grid RowDefinitions="*" ColumnDefinitions="*,120">
                                    <Label Text="{Binding Title}" LineBreakMode="TailTruncation" FontSize="18" Grid.Column="0"/>
                                    <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="15" Margin="15,0" VerticalTextAlignment="Center" Opacity=".8" Grid.Column="1"/>
                                </Grid>
                                <Label Text="{Binding Description}" FontSize="15" LineBreakMode="TailTruncation" Opacity=".8" Margin="0,0,20,0"/>
                            </VerticalStackLayout>
                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="Notes:" FontSize="18" Margin="0,15"/>
            <Label Text="{Binding Notes}"/>


        </VerticalStackLayout>
        <Button Text="Mark Returned" Grid.Row="1" BackgroundColor="#536578" TextColor="WhiteSmoke" Margin="5" Clicked="ReturnedButton_Clicked"/>

    </Grid>
</ContentPage>