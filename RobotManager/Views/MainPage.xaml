<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,0"
            Spacing="25">
            <Frame BackgroundColor="#303030">
                <VerticalStackLayout>
                    <Label Text="Upcomming Games:" FontSize="20"/>
                    <CollectionView x:Name="GamesCV" EmptyView="No games planned" Margin="0,10" VerticalOptions="Fill" MaximumHeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{StaticResource DefaultColor}" BorderColor="{StaticResource DefaultColor}" HasShadow="False" Margin="2">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding CountdownStarted}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource DefaultColor}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding CountdownStarted}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource GameColor}"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                    <Grid RowDefinitions="*,*" ColumnDefinitions="150,*,*">
                                        <Label Text="{Binding Against}" Grid.Row="0" Grid.Column="0"/>
                                        
                                            <Label Text="{Binding Field, StringFormat='Field {0}'}" Grid.Row="0" Grid.Column="1"/>
                                            <Label FontSize="15" Opacity=".6" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="2">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Home}" Value="True">
                                                        <Setter Property="Text" Value="Home"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Home}" Value="False">
                                                        <Setter Property="Text" Value="Away"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        
                                        <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" Grid.Row="1" Grid.Column="0"/>
                                        <Label Text="{Binding Date, StringFormat='{0:HH:mm}'}" Grid.Row="1" Grid.Column="1"/>
                                        <Label Text="{Binding CountdownText}" Grid.Row="1" Grid.Column="2"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Add Game" TextColor="WhiteSmoke"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="#303030">
                <VerticalStackLayout>
                    <Label Text="Robots in Clinic" FontSize="20"/>
                    <CollectionView EmptyView="No robots in clinic" Margin="0,10">

                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
