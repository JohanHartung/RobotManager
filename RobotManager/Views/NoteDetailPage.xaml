<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.NoteDetailPage"
             Title="NoteDetailPage">
    <Grid Padding="20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout Grid.Row="0">
            <Label Text="{Binding Title}" Margin="0,0,10,0" FontSize="22" VerticalTextAlignment="Center" Grid.Column="0"/>
            <BoxView BackgroundColor="#2f2f2f" HeightRequest="2" Margin="0,15,0,10"/>
                <Label Text="{Binding AuthorName}" FontSize="15" LineBreakMode="TailTruncation" Opacity=".8" MaxLines="2"/>
            <Label FontSize="15" Opacity=".6" Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Date, StringFormat='{0:dd.MM.yyyy  HH:mm}'}"/>
            <BoxView BackgroundColor="#2f2f2f" HeightRequest="2" Margin="0,10,0,20"/>
            <Label Text="{Binding Description}"/>
        </VerticalStackLayout>
        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="End" Margin="0,0,-15,0">
            <VerticalStackLayout x:Name="OptionsInterface" IsVisible="False" Margin="0,0,20,10" WidthRequest="180" Spacing="10">
                <Button x:Name="EditButton" Clicked="EditButton_Clicked" Text="Edit" IsVisible="True" BackgroundColor="#536578" TextColor="WhiteSmoke" Padding="-10" HeightRequest="40"/>
                <Button x:Name="RemoveButton" Clicked="RemoveButton_Clicked" Text="Remove" IsVisible="True" BackgroundColor="#80464d" TextColor="WhiteSmoke" Padding="-10" HeightRequest="40"/>
            </VerticalStackLayout>
            <Button 
    x:Name="OptionsButton"
    Clicked="OptionsButton_Clicked"
    Text="+"
    WidthRequest="60"
    HeightRequest="60"
    CornerRadius="28"
    BackgroundColor="#536578"
    TextColor="WhiteSmoke"
    FontSize="30"
    VerticalOptions="End"
    HorizontalOptions="End"
    Margin="0,0,16,16"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>