<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.RobotsPage"
             Title="Robots">
    <Grid Padding="20,0"
          RowDefinitions="Auto,*">
        <Grid RowDefinitions="auto, auto" Grid.Row="0">
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Grid.Row="0">
                <Button x:Name="AllFilterButton" BackgroundColor="{StaticResource DefaultColor}" TextColor="WhiteSmoke" Grid.Column="0" Margin="3" Text="All" Clicked="FilterButton_Clicked"/>
                <Button x:Name="NaoFilterButton" BackgroundColor="#303030" TextColor="WhiteSmoke" Grid.Column="1" Margin="3" Text="Nao" Clicked="FilterButton_Clicked"/>
                <Button x:Name="BoosterFilterButton" BackgroundColor="#303030" TextColor="WhiteSmoke" Grid.Column="2" Margin="3" Text="Booster" Clicked="FilterButton_Clicked"/>
                <Button x:Name="OtherFilterButton" BackgroundColor="#303030"  TextColor="WhiteSmoke"  Grid.Column="3" Margin="3" Text="Other" Clicked="FilterButton_Clicked"/>
            </Grid>
            <Grid x:Name="NaoVersionFilterGrid" Grid.Row="1" ColumnDefinitions="*,*,*" IsVisible="False">
                <Button x:Name="NaoAllFilterButton" class="Nao" BackgroundColor="{StaticResource DefaultColor}" TextColor="WhiteSmoke" Grid.Column="0" Margin="3" Text="All" Clicked="SubFilterButton_Clicked"/>
                <Button x:Name="NaoV5FilterButton"  class="Nao" BackgroundColor="#303030" TextColor="WhiteSmoke" Grid.Column="1" Margin="3" Text="v5.0 H25" Clicked="SubFilterButton_Clicked"/>
                <Button x:Name="NaoV6FilterButton"  class="Nao" BackgroundColor="#303030" TextColor="WhiteSmoke" Grid.Column="2" Margin="3" Text="v6.0" Clicked="SubFilterButton_Clicked"/>
            </Grid>
            <!--<Picker x:Name="SortByPicker" Title="Sort by"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Name</x:String>
                        <x:String>Warranty</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Button x:Name="SortDirectionButton" BackgroundColor="#303030"  TextColor="WhiteSmoke" Grid.Row="1"  Grid.Column="3" Margin="3" Text="↑↓" FontSize="25" Padding="0" />-->
        </Grid>
        <RefreshView x:Name="RobotPageRV" Refreshing="RefreshView_Refreshing" Grid.Row="1">
            <CollectionView x:Name="RobotCollection" EmptyView="No Robots">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" BackgroundColor="#303030" BorderColor="#303030" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Robot_Tapped"/>
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="auto, auto" ColumnDefinitions="auto, *">
                                <Label FontSize="24" Text="{Binding HeadNumber}" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalOptions="Center"/>
                                <HorizontalStackLayout Margin="10,0,0,0" Grid.Row="0" Grid.Column="1">
                                    <Label Text="{Binding Model}" Opacity=".7" VerticalOptions="Center"/>
                                    <Label Text="{Binding Version, StringFormat=' v{0}'}" Opacity=".7"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding WarrantyInfo}" Opacity=".8" Grid.Row="1" Margin="10,0,0,0" Grid.Column="1"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Button 
            x:Name="AddButton"
            Clicked="AddButton_Clicked"
            Text="+"
            Grid.Row="1"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="28"
            BackgroundColor="#536578"
            TextColor="WhiteSmoke"
            FontSize="30"
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,16,16"
            IsVisible="False"/>
    </Grid>
</ContentPage>