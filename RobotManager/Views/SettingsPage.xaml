<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="20">
        <Label Text="API" FontSize="20"/>
        <Label Text="Change API Domain" FontSize="15"/>
        <Label x:Name="uriText" Text="https://" FontSize="15" Opacity=".8"/>
        <Entry x:Name="domainEntry" Placeholder="example.com" TextChanged="domainEntry_TextChanged"/>
        <Button Text="Confirm" TextColor="WhiteSmoke" Clicked="Button_Clicked"/>

    </VerticalStackLayout>
</ContentPage>