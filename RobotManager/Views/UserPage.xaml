<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotManager.Views.UserPage"
             Title="Sign In">
    <VerticalStackLayout>
        <Grid x:Name="UserUI" Padding="20,0" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <VerticalStackLayout Grid.Row="0">
                <Frame HeightRequest="150" WidthRequest="150" HorizontalOptions="Start" CornerRadius="75">
                    <Image Source="http://www.hofmann-transport.com/wp-content/uploads/2017/08/facebook-default-no-profile-pic-350x350.jpg"/>
                </Frame>
                <HorizontalStackLayout Margin="0,15,0,0">
                    <Label x:Name="UserNameLabel" Text="User Name" Margin="0,0,10,0" FontSize="22" Grid.Column="0" VerticalTextAlignment="Center"/>
                    <Label Text="pro/nouns" Opacity=".7" VerticalOptions="Center" FontSize="20" IsVisible="False"/>
                </HorizontalStackLayout>
                <Label x:Name="teamLabel" Text="Berlin United" Opacity=".9" FontSize="16"/>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="auto,auto,*" Grid.Row="1" Margin="0,15">
                <Label Text="Your activity" Grid.Row="0" FontSize="18" FontAttributes="Bold"/>
                <BoxView BackgroundColor="#2f2f2f" HeightRequest="2" Margin="0,10,0,10" Grid.Row="1" Grid.ColumnSpan="3"/>
                <Button x:Name="NotesButton" Margin="3" Text="Notes" Grid.Column="0" Grid.Row="2" BackgroundColor="{StaticResource FreeColor}" TextColor="WhiteSmoke" Clicked="TabButton_Clicked"/>
                <Button x:Name="IssuesButton" Margin="3" Text="Issues" Grid.Column="1" Grid.Row="2" BackgroundColor="{StaticResource Gray550}" TextColor="WhiteSmoke" Clicked="TabButton_Clicked"/>
                <Button x:Name="ClinicButton" Margin="3" Text="Clinic Visits" Grid.Column="2" Grid.Row="2" BackgroundColor="{StaticResource Gray550}" TextColor="WhiteSmoke" Clicked="TabButton_Clicked"/>
            </Grid>

            <VerticalStackLayout Grid.Row="2" VerticalOptions="FillAndExpand">

                <StackLayout x:Name="NoteLayout" VerticalOptions="FillAndExpand">
                    <BoxView HeightRequest="18 " BackgroundColor="Transparent"/>
                    <CollectionView x:Name="NoteCV" EmptyView="No Notes" Margin="0,5">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame x:Name="NoteFrame" BackgroundColor="#282828" Margin="0,5"  Padding="0" BorderColor="#282828" HasShadow="False">
                                    <VerticalStackLayout>
                                        <Frame BackgroundColor="#303030" BorderColor="#303030" Padding="10" >
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Frame_Tapped"/>
                                            </Frame.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" FontSize="18"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="15" VerticalTextAlignment="Center" Opacity=".8"/>
                                                <Label Text="{Binding Description}" FontSize="15" LineBreakMode="TailTruncation" Opacity=".8" MaxLines="2"/>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <StackLayout x:Name="IssueLayout" IsVisible="False" Grid.Row="2">
                    <Grid x:Name="solvedIssuesGrid" ColumnDefinitions="auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SwitchGrid_Tapped"/>
                        </Grid.GestureRecognizers>
                        <Switch x:Name="solvedIssuesSwitch" Grid.Column="0" VerticalOptions="CenterAndExpand" Toggled="Switch_Toggled"/>
                        <Label Text="Include solved issues" Grid.Column="1" VerticalTextAlignment="Center" FontSize="16" FontAttributes="Bold" Margin="10"/>
                    </Grid>
                    <CollectionView x:Name="IssueCV" EmptyView="No issues">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame x:Name="IssueFrame" BackgroundColor="#282828" Margin="0,5"  Padding="0" BorderColor="#282828" HasShadow="False">
                                    <VerticalStackLayout>
                                        <Frame BackgroundColor="#303030" BorderColor="#303030" Padding="10" >
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Frame_Tapped"/>
                                            </Frame.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" LineBreakMode="TailTruncation" FontSize="18" Grid.Column="0"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="15" VerticalTextAlignment="Center" Opacity=".8" Grid.Column="1"/>
                                                <Grid ColumnDefinitions="auto,10,auto">
                                                    <Label FontSize="15" Opacity=".6" Grid.Column="0" VerticalTextAlignment="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsReplicated}" Value="True">
                                                                <Setter Property="Text" Value="Replicated"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsReplicated}" Value="False">
                                                                <Setter Property="Text" Value="Not yet replicated"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label FontSize="15" Opacity=".6" Grid.Column="2" VerticalTextAlignment="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSolved}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Solved[1], StringFormat='Solved: {0}'}"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Solved}" Value="False">
                                                                <Setter Property="Text" Value="Not solved"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                                <Label Text="{Binding Description}" FontSize="15" LineBreakMode="TailTruncation" Opacity=".8" Margin="0,0,20,0" MaxLines="2"/>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <StackLayout x:Name="ClinicLayout" IsVisible="False" Grid.Row="2">
                    <Grid x:Name="pastVisitGrid" ColumnDefinitions="auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SwitchGrid_Tapped"/>
                        </Grid.GestureRecognizers>
                        <Switch x:Name="pastVisitSwitch" Grid.Column="0" VerticalOptions="CenterAndExpand" Toggled="Switch_Toggled"/>
                        <Label Text="Include past visits" Grid.Column="1" VerticalTextAlignment="Center" FontSize="16" FontAttributes="Bold" Margin="10"/>
                    </Grid>
                    <CollectionView x:Name="ClinicCV" EmptyView="No clinic visits">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame x:Name="ClinicFrame" BackgroundColor="#282828" Margin="0,5"  Padding="0" BorderColor="#303030" HasShadow="False">
                                    <VerticalStackLayout>

                                        <Frame BackgroundColor="#303030" BorderColor="#303030" Padding="10" >
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Frame_Tapped"/>
                                            </Frame.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding DisplayID, StringFormat='Clinic Visit #{0}'}" FontSize="18"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="15" VerticalTextAlignment="Center" Opacity=".8"/>
                                                <Label FontSize="15" Opacity=".6" Grid.Column="0" VerticalTextAlignment="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBack}" Value="True">
                                                            <Setter Property="Text" Value="Returned"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBack}" Value="False">
                                                            <Setter Property="Text" Value="Still in Clinic"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding IssueCount, StringFormat='{0} Issues'}" FontSize="15" LineBreakMode="TailTruncation" Opacity=".8"/>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </VerticalStackLayout>

        </Grid>
        <VerticalStackLayout x:Name="SignInUI" VerticalOptions="Center" IsVisible="False" Margin="0,200,0,0">
                    <Frame x:Name="UsernameEtryForm" BackgroundColor="{StaticResource Gray550}" BorderColor="Transparent" Margin="10">
                        <VerticalStackLayout>
                            <Label Text="Register or Sing In" TextColor="WhiteSmoke" FontSize="Body"/>
                            <Entry x:Name="UsernameEntry1" Placeholder="Username" Margin="0,20"/>
                            <Button x:Name="UsernameEtryContinueButton" Text="Continue" TextColor="WhiteSmoke" Clicked="ContinueButton_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame x:Name="PasswordEtryForm" BackgroundColor="{StaticResource Gray550}" BorderColor="Transparent" Margin="10" IsVisible="False">
                        <VerticalStackLayout>
                            <Label Text="Sing In" TextColor="WhiteSmoke" FontSize="Body"/>
                            <Entry x:Name="PasswordEntry1" Placeholder="Password" Margin="0,20" IsPassword="True"/>
                            <Button x:Name="PasswordEntryContinueButton" Text="Sign In" TextColor="WhiteSmoke" Clicked="ContinueButton_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame x:Name="RegistrationCodeEtryForm" BackgroundColor="{StaticResource Gray550}" BorderColor="Transparent" Margin="10" IsVisible="False">
                        <VerticalStackLayout>
                            <Label Text="Register" TextColor="WhiteSmoke" FontSize="Body"/>
                            <Entry x:Name="RegistrationCodeEntry" Placeholder="Registration Code" Margin="0,20" Keyboard="Numeric"/>
                            <Button x:Name="RegistrationCodeEntryContinueButton" Text="Continue" TextColor="WhiteSmoke" Clicked="ContinueButton_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame x:Name="RegistrationEtryForm" BackgroundColor="{StaticResource Gray550}" BorderColor="Transparent" Margin="10" IsVisible="False">
                        <VerticalStackLayout>
                            <Label Text="Register" TextColor="WhiteSmoke" FontSize="Body"/>
                            <Entry x:Name="UsernameEntry2" Placeholder="Username" ReturnType="Next" Margin="0,20,0,0"/>
                            <Label x:Name="UsernameCheckText" Text="Username is available" Margin="4,0" FontSize="12" TextColor="{StaticResource FreeColor}"/>
                            <Entry x:Name="PasswordEntry2" Placeholder="Password" IsPassword="True" Margin="0,5,0,20"/>
                            <Button x:Name="RegistrationEntryContinueButton" Text="Continue" TextColor="WhiteSmoke" Clicked="ContinueButton_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
</ContentPage>